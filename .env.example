# Скопируйте этот файл в .env для локального запуска и заполните значения.
# В GitHub Actions эти же имена задаются как Repository Secrets / Variables.

# Обязательные параметры
GROQ_API_KEY=your_groq_api_key_here
BOT_TOKEN=your_telegram_bot_token_here
CHANNEL_ID=@your_channel_or_chat_id

# Необязательные параметры (значения по умолчанию — в market_voice_bot/config.py)
# GROQ_MODEL=llama-3.1-8b-instant
# RSS_URLS=https://cointelegraph.com/rss,https://cryptoslate.com/feed/
# MAX_NEWS_PER_RUN=5
# DB_PATH=data/state.db
# LOG_LEVEL=INFO
